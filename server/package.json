{
  "name": "bomberif-server",
  "version": "1.0.0",
  "description": "Backend do bomberif",
  "author": "Binary-Phantom Vinícius Nogueira Proença ",
  "main": "src/index.ts",
  "scripts": {
    "dev": "cross-env dev=1 nodemon src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=build/index.js",
    "deploy": "./deploy.sh",
    "start": "node build/index.js",
    "test:chain": "ts-node --transpile-only -r tsconfig-paths/register test/chainReaction.test.ts",
    "test:ranking": "ts-node --transpile-only -r tsconfig-paths/register test/ranking.test.ts",
    "test:stun": "ts-node --transpile-only -r tsconfig-paths/register test/stun.test.ts",
    "test:lobby": "ts-node --transpile-only -r tsconfig-paths/register test/lobby.test.ts",
    "test:frank": "ts-node --transpile-only -r tsconfig-paths/register test/frank.test.ts",
    "test:virus": "ts-node --transpile-only -r tsconfig-paths/register test/virus.test.ts",
    "test:ihm": "ts-node --transpile-only -r tsconfig-paths/register test/ihm.test.ts",
    "test:kick": "ts-node --transpile-only -r tsconfig-paths/register test/kick.test.ts",
    "test:firewall": "ts-node --transpile-only -r tsconfig-paths/register test/firewall.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:signal": "ts-node --transpile-only -r tsconfig-paths/register test/signal.test.ts",
    "test:ping": "ts-node --transpile-only -r tsconfig-paths/register test/ping.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
